{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1080px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "base",
          "color": "#fffaf3",
          "name": "Kremowe tło"
        },
        {
          "slug": "contrast",
          "color": "#29231f",
          "name": "Ciemny tekst"
        },
        {
          "slug": "primary",
          "color": "#85351f",
          "name": "Ceglany akcent"
        },
        {
          "slug": "accent",
          "color": "#f6e5d1",
          "name": "Ciepły beż"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "Biel"
        }
      ]
    },
    "typography": {
      "fontSizes": [
        {
          "slug": "small",
          "name": "Mały",
          "size": "0.9rem"
        },
        {
          "slug": "medium",
          "name": "Zwykły",
          "size": "1.125rem"
        },
        {
          "slug": "large",
          "name": "Duży",
          "size": "clamp(1.35rem, 1.1rem + 1vw, 1.8rem)"
        },
        {
          "slug": "x-large",
          "name": "Tytuł",
          "size": "clamp(2rem, 1.3rem + 2.8vw, 3.6rem)"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "XS",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "S",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "M",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "L",
          "size": "2.5rem"
        },
        {
          "slug": "60",
          "name": "XL",
          "size": "4rem"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif",
      "fontSize": "1.125rem",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        },
        "typography": {
          "lineHeight": "1.2",
          "fontWeight": "750"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(2rem, 1.3rem + 2.8vw, 3.6rem)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.5rem, 1.2rem + 1.3vw, 2.2rem)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "10px"
        }
      }
    }
  }
}
